{
  // Cloudflare Workers Builds: serves the static web app in ./static.
  // "name" must match the Worker's name in the Cloudflare dashboard.
  "name": "agribridge",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./static",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application"
  },
  "rules": [
    { "type": "Text", "globs": ["**/*.html"], "fallthrough": true }
  ]
}
